// Стекло витрины: тёмные пиксели стекла прозрачны, блики полупрозрачны — сквозь окно виден зал.
bool in_rect(vec2 p, vec4 r) {
	return p.x >= r.x && p.x < r.x + r.z && p.y >= r.y && p.y < r.y + r.w;
}

// -1 — не стекло; иначе альфа стеклянного пикселя (0 — совсем прозрачный, больше — блик).
float glass_alpha(vec3 c) {
	if (distance(c, vec3(0.125, 0.180, 0.216)) < 0.05) {
		return 0.0;
	}
	if (distance(c, vec3(0.341, 0.447, 0.467)) < 0.05) {
		return 0.55;
	}
	return -1.0;
}
